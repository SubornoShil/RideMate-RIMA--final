# Copy to .env and export the values (or use your host's dashboard).
# Development runs without any of these.
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Required in production ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=ridetogether.example
CSRF_TRUSTED_ORIGINS=https://ridetogether.example
BEHIND_PROXY=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
ADMIN_URL=manage-rt-7f3k/

# --- Database (PostgreSQL is used when DB_NAME is set, SQLite otherwise) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Cache (login lockout needs a shared cache when running several workers) ---
REDIS_URL=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=RideMate <no-reply@ridetogether.example>

# --- SMS: console | twilio | http ---
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_SENDER=RideMate

# --- Optional ---
GOOGLE_MAPS_API_KEY=
PLAUSIBLE_DOMAIN=
CONTACT_EMAIL=
SENTRY_DSN=
